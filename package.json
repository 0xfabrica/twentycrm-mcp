{
  "name": "twentycrm-mcp",
  "version": "0.1.1",
  "description": "Unofficial MCP server for safe, composable access to the Twenty CRM REST API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "twentycrm-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node tests/protocol-smoke.mjs",
    "test:live": "npm run build && node --env-file=.env tests/live-smoke.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xfabrica/twentycrm-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "twenty",
    "twenty-crm",
    "crm",
    "codex",
    "claude"
  ],
  "author": "0xfabrica",
  "license": "MIT",
  "homepage": "https://github.com/0xfabrica/twentycrm-mcp#readme",
  "bugs": {
    "url": "https://github.com/0xfabrica/twentycrm-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.18.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
