# Twenty Cloud: https://api.twenty.com/rest
# Self-hosted: https://your-domain.example/rest
TWENTY_API_URL=https://api.twenty.com/rest
TWENTY_API_KEY=replace_with_your_api_key

# Optional safety controls
# Omit TWENTY_WRITABLE_ENTITIES to use the default CRM write allowlist below.
# Set it to an empty value (TWENTY_WRITABLE_ENTITIES=) for read-only mode.
# TWENTY_WRITABLE_ENTITIES=companies,people,opportunities,tasks,notes,noteTargets,taskTargets
# false blocks soft deletes and real merges, but ordinary writes above remain enabled.
TWENTY_ALLOW_DESTRUCTIVE=false
